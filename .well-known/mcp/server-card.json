{
  "serverInfo": {
    "name": "ilongda-public-discovery",
    "version": "2026.06.09",
    "description": "Agent discovery card for public blog resources and browser-side WebMCP tools on ilongda.com."
  },
  "transport": {
    "type": "webmcp",
    "endpoint": "https://ilongda.com/"
  },
  "capabilities": {
    "tools": false,
    "resources": true,
    "prompts": false
  },
  "resources": [
    {
      "uri": "https://ilongda.com/llms.txt",
      "name": "Agent-readable site guide",
      "mimeType": "text/plain"
    },
    {
      "uri": "https://ilongda.com/llms-full.txt",
      "name": "Full public content archive",
      "mimeType": "text/plain"
    },
    {
      "uri": "https://ilongda.com/search.xml",
      "name": "Public search index",
      "mimeType": "application/xml"
    }
  ]
}
