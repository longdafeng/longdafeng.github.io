# Cloudflare Pages headers — auto-generated by generate-cf-files.js. Do not edit by hand.

# Fingerprinted / rarely-changing static assets: cache aggressively.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/lib/*
  Cache-Control: public, max-age=31536000, immutable
/fancybox/*
  Cache-Control: public, max-age=31536000, immutable
/font-awesome/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images: cache for 30 days.
/img/*
  Cache-Control: public, max-age=2592000
/images/*
  Cache-Control: public, max-age=2592000
/background/*
  Cache-Control: public, max-age=2592000
/assets/*
  Cache-Control: public, max-age=2592000

# Crawler / LLM text endpoints: pin text/plain and keep cache short so updates land fast.
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/ai.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms.txt
